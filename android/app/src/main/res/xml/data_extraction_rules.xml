<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Only a validated, opt-in JSON snapshot. Never the raw database or photos. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="system-backup/training.json.gz"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="system-backup/training.json.gz"/>
    </device-transfer>
</data-extraction-rules>
