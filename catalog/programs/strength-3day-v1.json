  "name": "Strength Fundamentals",
  "weeks": 4,
  "daysPerWeek": 3,
  "description": "Three main movements per day with longer rests and a bounded four-to-six rep range.",
  "goals": [
    "strength"
  ],
  "level": "intermediate",
