{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avivajpeyi.github.io/fitnotes/data/programs/schema-v1.json",
  "title": "FitNotes portable program definition v1",
  "type": "object",
  "required": ["schemaVersion", "id", "programVersion", "name", "weeks", "days"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "programVersion": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "maxLength": 2000},
    "weeks": {"type": "integer", "minimum": 1, "maximum": 52},
    "daysPerWeek": {"type": "integer", "minimum": 1, "maximum": 14},
    "startDate": {"type": "string", "format": "date"},
    "goals": {"$ref": "#/$defs/textList"}, "equipment": {"$ref": "#/$defs/textList"},
    "level": {"type": "string"},
    "progression": {"type": ["string", "object", "array"]},
    "schedule": {"type": ["string", "object", "array"]},
    "source": {"type": "object", "properties": {"title": {"type": "string", "maxLength": 2000}, "url": {"type": "string", "maxLength": 2048}, "author": {"type": "string", "maxLength": 2000}, "attribution": {"type": "string", "maxLength": 2000}}, "additionalProperties": true},
    "days": {"type": "array", "minItems": 1, "maxItems": 14, "items": {"type": "object", "required": ["id", "name", "exercises"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 200}, "notes": {"type": "string", "maxLength": 2000}, "date": {"type": "string", "format": "date"}, "durationMinutes": {"type": "integer", "minimum": 0, "maximum": 720},
      "exercises": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/exercise"}}
    }, "additionalProperties": true}}
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "textList": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 200}},
    "target": {"type": "object", "properties": {
      "reps": {"type": ["integer", "string"]}, "repsMin": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000}, "repsMax": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000},
      "restSeconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 3600}, "rir": {"type": ["number", "null"], "minimum": 0, "maximum": 10}, "rpe": {"type": ["number", "null"], "minimum": 1, "maximum": 10},
      "weight": {"type": ["string", "number", "null"]}, "unit": {"enum": ["kg", "lb", "bodyweight", null]},
      "loadMode": {"enum": ["external", "bodyweight", "assistance", "reps_only", "unknown"]}, "isWarmUp": {"type": "boolean"}
    }, "additionalProperties": true},
    "exercise": {"type": "object", "required": ["name", "sets"], "properties": {
      "canonicalId": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 200}, "sourceName": {"type": "string", "maxLength": 200}, "notes": {"type": "string", "maxLength": 2000},
      "sets": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 100}, {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/target"}}]},
      "reps": {"type": ["integer", "string"]}, "repRangeMin": {"type": "integer", "minimum": 1, "maximum": 1000}, "repRangeMax": {"type": "integer", "minimum": 1, "maximum": 1000}, "restSeconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 3600}, "rir": {"type": ["number", "null"], "minimum": 0, "maximum": 10}, "rpe": {"type": ["number", "null"], "minimum": 1, "maximum": 10}, "loadMode": {"enum": ["external", "bodyweight", "assistance", "reps_only", "unknown"]},
      "substitutions": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 200}}
    }, "additionalProperties": true}
  }
}
